{
  "manifest_version": 3,
  "name": "Any Video Downloader",
  "version": "3.0.0",
  "description": "Detect and download accessible videos from web pages, including direct files, unencrypted HLS, DASH/adaptive streams, signed CDN media, and local audio/video merging.",
  "permissions": ["downloads", "offscreen", "storage", "webNavigation", "webRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["title-helper.js", "content.js", "hls-page-capture.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-listener.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-probe.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["spa-navigation-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}
}
