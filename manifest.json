{
  "manifest_version": 3,
  "name": "GHL Course Video Downloader",
  "version": "1.3.3",
  "description": "Downloads GoHighLevel course videos individually or automatically across lessons, with in-player navigation and live progress.",
  "permissions": [
    "downloads",
    "offscreen",
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.clientclub.net/*",
        "https://*.gohighlevel.com/*",
        "https://app.gohighlevel.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-probe.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; object-src 'none';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}